# Ensure consistent line endings across all platforms
# All text files should use LF (Unix-style) line endings

# Source code
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Configuration files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Templates and content
*.html text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
